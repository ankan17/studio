{
  "name": "studio",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@10.0.0",
  "scripts": {
    "dev": "pnpm --filter @studio/desktop start",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "release": "pnpm --filter @studio/desktop package && bash scripts/make-dmg.sh"
  },
  "devDependencies": {
    "turbo": "^2.5.0",
    "typescript": "5.9.3",
    "vitest": "^3.2.0",
    "tsx": "^4.20.0"
  },
  "pnpm": {
    "overrides": {
      "yauzl": "3.4.0"
    }
  }
}
